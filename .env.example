# ---- Plivo (MAIN account credentials of an India data-region organization) ----
PLIVO_AUTH_ID=MAXXXXXXXXXXXXXXXXXX
PLIVO_AUTH_TOKEN=change-me
# Plivo Application that answers / drives your AI calls. Every number bought gets attached to it.
PLIVO_APP_ID=
# true = no real Plivo calls (fake numbers, KYC auto-approves). Use for local dev / demos.
PLIVO_MOCK=true

# ---- Country / product ----
COUNTRY_ISO=IN
# India: 'local' = landline series (080, 022...), the only self-serve type. Plivo allows it for
# SERVICE / TRANSACTIONAL calls only. Promotional calls need 140-series numbers (manual Plivo + Tata DLT process).
ALLOWED_NUMBER_TYPES=local
# Plivo's reseller flow: create one Plivo subaccount per client and file its KYC + numbers there.
PLIVO_USE_SUBACCOUNTS=true
# Cities shown in the "Buy numbers" dropdown, spelled exactly as Plivo spells them.
# Plivo currently has India landline stock only in Bangalore (+91 80) and Mumbai (+91 22).
NUMBER_CITIES=Bangalore,Mumbai
# Which KYC documents a client must upload, out of those Plivo's Requirements API lists:
#   all = every listed type (Compliance API spec for India: Registration Certificate AND GST Certificate)
#   one = exactly one of them (wording of Plivo's India console guide). Confirm with Plivo.
KYC_DOCUMENTS_MODE=all

# ---- This service ----
# Public HTTPS URL of this service, used to build the Plivo compliance callback_url.
# Leave empty to skip callbacks (the background poller still refreshes statuses).
PUBLIC_BASE_URL=
DATABASE_URL=sqlite:///./plivo_numbers.db
# Shared secret your main dashboard uses to sign client JWTs (HS256). Also signs webhook URLs.
JWT_SECRET=change-me-to-a-long-random-string
# Key used by your dialer / internal services and admins (header: X-Admin-Key)
ADMIN_API_KEY=change-me-admin-key
# Enables /api/dev/token (mint a token for any client id). NEVER enable in production.
DEV_MODE=true

# ---- Business rules ----
MAX_NUMBERS_PER_CLIENT=10
# Seconds between background refreshes of pending KYC applications (0 disables)
COMPLIANCE_POLL_SECONDS=300
# Your markup over Plivo prices, e.g. 1.2 = +20% (used for display + billing ledger)
PRICE_MARKUP=1.0
